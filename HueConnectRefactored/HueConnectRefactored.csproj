<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>HueConnectRefactored</RootNamespace>
    <AssemblyName>HueConnectRefactored</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <Authors>Robocnop</Authors>
    <Product>HueConnectRefactored</Product>
    <Copyright>Copyright © 2026 Robocnop</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <NovaManaged Condition=" '$(NovaManaged)' == '' ">D:\SteamLibrary\steamapps\common\Nova-Life\Nova-Life_Data\Managed</NovaManaged>
    <ModKitLibs Condition=" '$(ModKitLibs)' == '' ">$(UserProfile)\Downloads</ModKitLibs>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NovaManaged)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>$(NovaManaged)\Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(NovaManaged)\Mirror.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NovaManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NovaManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ModKit">
      <HintPath>$(ModKitLibs)\ModKit.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AAMenu">
      <HintPath>$(ModKitLibs)\AAMenu.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
